    SerializationNodes: []
  _udonSharpBackingUdonBehaviour: {fileID: 570450971161394925}
  uSharpVideoPlayer: {fileID: 844468986}
  subtitlesManager1: {fileID: 264980896}
  unityVideoPlayer: {fileID: 0}
  avProVideoPlayer: {fileID: 0}
  subtitlesManager2: {fileID: 0}
  overlayHandler: {fileID: 0}
  screenUnityVideoPlayer: {fileID: 0}
  screenAvProVideoPlayer: {fileID: 0}
  testVideo:
    url: https://www.youtube.com/watch?v=UMBxESl38o0
  testRemoteSubtitles:
    url: 
  testSubtitles: "1\r\n00:00:00,950 --> 00:00:04,994\r\nSPEAKER: Making friends here\nis
    sometimes what saves\npeople's lives.\r\n\r\n2\r\n00:00:06,269 --> 00:00:08,881\r\nOr
    what gets them up out of bed\nin the morning.\r\n\r\n3\r\n00:00:08,981 --> 00:00:10,800\r\n\u266A
    (UPBEAT MUSIC PLAYS) \u266A\r\n\r\n4\r\n00:00:13,450 --> 00:00:15,650\r\nI am
    a teacher\nfor Helping Hands,\r\n\r\n5\r\n00:00:15,750 --> 00:00:18,433\r\na
    sign language community\nhere in VR chat.\r\n\r\n6\r\n00:00:18,533 --> 00:00:21,219\r\nHand
    rested under elbow\nand we're gonna go like this.\r\n\r\n7\r\n00:00:21,319 -->
    00:00:22,504\r\nChristmas.\r\n\r\n8\r\n00:00:23,104 --> 00:00:25,215\r\nSlow,
    quick, quick, slow.\r\n\r\n9\r\n00:00:25,315 --> 00:00:28,868\r\nIf I had confidence
    that I could\nteach dance as a living in VR,\r\n\r\n10\r\n00:00:28,968 --> 00:00:30,537\r\nI
    totally would do exactly that.\r\n\r\n11\r\n00:00:30,662 --> 00:00:32,997\r\nSPEAKER
    2: With a long distance\nrelationship,\r\n\r\n12\r\n00:00:33,097 --> 00:00:35,325\r\nhaving
    VR is a game changer.\r\n\r\n13\r\n00:00:35,425 --> 00:00:38,169\r\nSPEAKER 3:\nWe
    are 5,000 miles apart,\r\n\r\n14\r\n00:00:38,269 --> 00:00:40,788\r\nbut we're
    gonna try our best\nto make it work.\r\n\r\n15\r\n00:00:42,788 --> 00:00:44,292\r\nSPEAKER
    4:\nThis year has been really hard.\r\n\r\n16\r\n00:00:44,392 --> 00:00:45,810\r\nThe
    thing that has kept me sane\r\n\r\n17\r\n00:00:45,910 --> 00:00:48,838\r\nhas
    been VR\nand the VR community.\r\n\r\n18\r\n00:00:50,363 --> 00:00:52,834\r\nI
    would not have weathered this\nwithout you guys.\r\n\r\n19\r\n00:00:52,934 -->
    00:00:56,738\r\nThree, two, one,\nhappy New Year!\r\n\r\n20\r\n00:00:57,323 -->
    00:00:58,648\r\n(DINOSAUR ROARS)\r\n\r\n21\r\n00:00:58,767 --> 00:00:59,850\r\n\u266A
    (MUSIC CONTINUES) \u266A\r\n\r\n22\r\n00:00:59,950 --> 00:01:02,944\r\nSPEAKER
    5: You can be\nwho you've always wanted to be.\r\n\r\n23\r\n00:01:03,044 -->
    00:01:05,463\r\nAnd you can,\nin a way, start over.\r\n\r\n24\r\n00:01:06,213
    --> 00:01:08,724\r\nWe can come together\nand support each other.\r\n\r\n25\r\n00:01:09,024
    --> 00:01:10,543\r\nThis community\nmeans a lot to me\r\n\r\n26\r\n00:01:10,627
    --> 00:01:12,197\r\nand I really want them to know\nthat they're loved.\r\n\r\n27\r\n00:01:14,026
    --> 00:01:15,782\r\n-SPEAKER 6: True.\n-It's been a year since...\r\n\r\n28\r\n00:01:15,907
    --> 00:01:18,659\r\n-SPEAKER 6: That's true.\n-...I've seen Kevin's IRL body.\r\n\r\n29\r\n00:01:18,909
    --> 00:01:20,420\r\n(LAUGHTER)\r\n\r\n30\r\n00:01:20,520 --> 00:01:22,505\r\n-It
    sounds funny.\n-\"Kevin's IRL body.\"\r\n\r\n"
